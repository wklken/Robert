{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robert Config",
  "type": "object",
  "$defs": {
    "routeOverride": {
      "type": "object",
      "properties": {
        "worker": {
          "type": "string",
          "minLength": 1
        },
        "required_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "multi_agent_vote": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "workers": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "multi_agent_review": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "workers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "author_allowlist": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Override ordinary automatic execution only; native multi-model stages use their named workers."
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "description": "Override ordinary automatic execution only; native multi-model stages use their named workers."
        }
      },
      "additionalProperties": false
    },
    "prAutomation": {
      "type": "object",
      "properties": {
        "conflict": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "max_wall_minutes": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "ci": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "check_allowlist": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "max_wall_minutes": {
              "type": "integer",
              "minimum": 1,
              "default": 120
            },
            "max_total_tokens": {
              "type": "integer",
              "minimum": 1,
              "default": 200000
            },
            "max_cost_usd": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 10.0
            },
            "max_failure_summary_chars": {
              "type": "integer",
              "minimum": 1,
              "default": 12000
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [
    "version",
    "data_dir",
    "database",
    "github",
    "default_worker",
    "workers",
    "repos"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "data_dir": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "github": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1
        },
        "polling": {
          "type": "object",
          "properties": {
            "fallback_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 300
            },
            "synchronous": {
              "type": "object",
              "properties": {
                "full_capacity_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 600
                },
                "rate_limit_cache_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 300
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "rate_limit": {
          "type": "object",
          "properties": {
            "min_search_remaining": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            },
            "min_core_remaining": {
              "type": "integer",
              "minimum": 1,
              "default": 500
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "account"
      ]
    },
    "skills": {
      "type": "object",
      "properties": {
        "search_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "daemon": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "scan_on_start": {
          "type": "boolean",
          "default": false
        },
        "control_timeouts": {
          "type": "object",
          "properties": {
            "github_scan_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 300
            },
            "local_cycle_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 180
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "workers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "adapter",
          "command",
          "model",
          "effort"
        ],
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "fallback_model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "default": 3600
          },
          "environment_allowlist": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          }
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/routeOverride"
      },
      "default": {}
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "full_name",
          "checkout",
          "worktrees",
          "default_branch",
          "trusted_actors"
        ],
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1
          },
          "github_account": {
            "type": "string",
            "minLength": 1
          },
          "checkout": {
            "type": "string",
            "minLength": 1
          },
          "worktrees": {
            "type": "string",
            "minLength": 1
          },
          "default_branch": {
            "type": "string",
            "minLength": 1
          },
          "trusted_actors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_concurrency": {
            "type": "integer",
            "minimum": 1
          },
          "pr_automation": {
            "$ref": "#/$defs/prAutomation"
          },
          "routes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/routeOverride"
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "default_worker": {
      "type": "string",
      "minLength": 1
    },
    "python_bin": {
      "type": "string",
      "minLength": 1
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "model_max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "local_poll_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "lease_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 540
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "supervision": {
      "type": "object",
      "properties": {
        "heartbeat_stale_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 1200
        },
        "hard_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 3600
        },
        "startup_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        },
        "mode": {
          "enum": [
            "off",
            "observe",
            "recover_known",
            "decide"
          ],
          "default": "observe"
        },
        "poll_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "stall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "build_manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "repair": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "mode": {
              "enum": [
                "backlog",
                "auto"
              ]
            },
            "repository": {
              "type": "string"
            },
            "worker": {
              "type": [
                "string",
                "null"
              ]
            },
            "allowed_actions": {
              "type": "array",
              "items": {
                "enum": [
                  "push_existing_pr",
                  "open_pr"
                ]
              }
            },
            "launcher": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verification_commands": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "max_repairs_per_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "repository"
          ],
          "additionalProperties": false
        },
        "recovery": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "spool_replay",
                  "audit_retry",
                  "handoff_resume",
                  "publication_retry",
                  "publication_reconcile"
                ]
              }
            },
            "repositories": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "allowed_actions",
            "repositories"
          ],
          "additionalProperties": false
        },
        "diagnosis": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string"
              }
            },
            "environment_allowlist": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string"
              }
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "cooldown_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "max_calls_per_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "decision": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string"
              }
            },
            "environment_allowlist": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string"
              }
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "cooldown_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "max_calls_per_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "default": 100,
          "maximum": 500
        },
        "retention": {
          "type": "object",
          "properties": {
            "runs_days": {
              "type": "integer",
              "minimum": 1,
              "default": 7
            },
            "failed_runs_days": {
              "type": "integer",
              "minimum": 1,
              "default": 30
            },
            "daemon_events_days": {
              "type": "integer",
              "minimum": 1,
              "default": 7
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "messaging": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "dispatch_enabled": {"type": "boolean", "default": false},
        "send_after": {
          "type": "string",
          "minLength": 1,
          "description": "Only externally deliver notifications created after this timezone-aware ISO timestamp. Required when enabled; retain on service restarts."
        },
        "provider": {
          "type": "string",
          "enum": [
            "openclaw"
          ],
          "default": "openclaw"
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "conversation": {
          "type": "string",
          "minLength": 1
        },
        "allowed_senders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "thread": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "additionalProperties": false
}
