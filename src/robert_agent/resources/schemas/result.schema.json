{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robert Compact Worker Submission",
  "type": "object",
  "required": [
    "planned_github_actions",
    "used_skills",
    "verification"
  ],
  "properties": {
    "planned_github_actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "const": "comment"
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "target_url": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "push_existing_pr"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "title",
              "body"
            ],
            "properties": {
              "type": {
                "const": "open_pr"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "issue_resolution": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "complete",
                  "partial"
                ]
              },
              "remaining_scope": {
                "type": "string",
                "minLength": 1
              },
              "target_url": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "const": "submit_pr_review"
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "target_url": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "consumed_event_fingerprints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumed_work_item_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operator_question": {
      "type": "object",
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "clarification",
            "scope_decision",
            "completion_acceptance"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "choices": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "used_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "status",
          "purpose",
          "required",
          "source"
        ],
        "properties": {
          "command": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "required": {
            "type": "boolean"
          },
          "skipped_reason": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "worker_reported",
              "runtime_recorded",
              "external_ci"
            ]
          },
          "command_record_path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            },
            "then": {
              "required": [
                "skipped_reason"
              ],
              "not": {
                "required": [
                  "exit_code"
                ]
              }
            },
            "else": {
              "required": [
                "exit_code"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "runtime_recorded"
                }
              }
            },
            "then": {
              "required": [
                "command_record_path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "external_ci"
                }
              }
            },
            "then": {
              "required": [
                "url"
              ]
            }
          }
        ]
      }
    },
    "handoff": {
      "type": "string"
    },
    "recommended_route": {
      "type": "string",
      "enum": [
        "",
        "comment-analysis",
        "new-pr",
        "update-existing-pr",
        "review-comment",
        "review-pr",
        "waiting-for-user",
        "vote"
      ]
    },
    "review_input_kind": {
      "type": "string",
      "enum": [
        "request",
        "review_feedback",
        "mixed"
      ]
    },
    "branch_slug": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^$|^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "memory_delta": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "used_memory_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remediation_evidence": {
      "type": "object",
      "required": [
        "resolution_summary"
      ],
      "properties": {
        "resolution_summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "review_point_evaluation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "summary",
          "verdict",
          "reasoning",
          "action"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "correct",
              "partially_correct",
              "incorrect",
              "unverified"
            ]
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "implement",
              "skip",
              "comment",
              "clarify"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "implement"
                }
              }
            },
            "then": {
              "properties": {
                "verdict": {
                  "enum": [
                    "correct",
                    "partially_correct"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "consumed_event_fingerprints"
      ]
    },
    {
      "required": [
        "consumed_work_item_event_ids"
      ]
    }
  ]
}
